[Desktop Entry]
Type=Application
Name=OmaLLDownloader
GenericName=Download Manager
Comment=Chunked HTTP downloads with resume, a command line, and a browser extension
Exec=omalldownloader %U
TryExec=omalldownloader
Icon=omalldownloader
Terminal=false
Categories=Network;Utility;
Keywords=download;downloader;http;wget;curl;
StartupWMClass=omalldownloader
# What this build actually handles. eD2k is absent because it is delegated to `amule`,
# which may not be installed; it gets added when the app can do it itself.
MimeType=x-scheme-handler/omalldownloader;x-scheme-handler/ftp;x-scheme-handler/ftps;x-scheme-handler/magnet;application/x-bittorrent;application/vnd.apple.mpegurl;application/dash+xml;
Actions=NewDownload;

[Desktop Action NewDownload]
Name=New download
Exec=omalldownloader
